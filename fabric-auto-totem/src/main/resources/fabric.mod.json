  "authors": ["NTH"],
  "license": "MIT",
  "icon": "assets/autototem/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["com.nth.autototem.AutoTotemClient"]
  },
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  }
}
